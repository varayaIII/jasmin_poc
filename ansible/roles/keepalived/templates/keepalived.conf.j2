vrrp_script chk_jasmind {
    script "/usr/local/bin/check_jasmind.sh"
    interval 5
    weight -20
}

vrrp_instance VI_1 {
    state {{ 'MASTER' if inventory_hostname == 'JasminNodoA' else 'BACKUP' }}
    interface eth0
    virtual_router_id 51
    priority {{ 101 if inventory_hostname == 'JasminNodoA' else 100 }}
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass 1234
    }
    virtual_ipaddress {
        12.4.8.190/24
    }
    track_script {
        chk_jasmind
    }
    notify_master "/bin/systemctl start jasmind"
    notify_backup "/bin/systemctl stop jasmind"
}
